<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>0.0.1</Version>
    <Author>Private Party Markers Contributors</Author>
    <Name>Private Party Markers</Name>
    <Punchline>Local-only dots beneath yourself and selected party teammates.</Punchline>
    <Description>Draws private, local-only floor dots beneath yourself and manually selected party teammates, with a 16-color preset palette. It does not alter game markers or upload data.</Description>
    <Tags>party;overlay;accessibility;local</Tags>
    <PackageLicenseExpression>AGPL-3.0-only</PackageLicenseExpression>
  </PropertyGroup>
</Project>
